{
    "name": "victorycodedev/toastkit",
    "version": "1.0.0",
    "description": "Rich, customizable native toast notifications for NativePHP Mobile.",
    "namespace": "ToastKit",
    "keywords": [
        "nativephp",
        "nativephp-plugin",
        "mobile",
        "toast",
        "notifications"
    ],
    "category": "utilities",
    "license": "MIT",
    "pricing": {
        "type": "free"
    },
    "author": {
        "name": "Victory Efekpogua",
        "url": "https://github.com/victorycodedev"
    },
    "homepage": "https://github.com/victorycodedev/toastkit",
    "repository": "https://github.com/victorycodedev/toastkit",
    "platforms": [
        "android",
        "ios"
    ],
    "bridge_functions": [
        {
            "name": "ToastKit.Show",
            "android": "com.victorycodedev.plugins.toastkit.ToastKitFunctions.Show",
            "ios": "ToastKitFunctions.Show",
            "description": "Displays a native toast."
        },
        {
            "name": "ToastKit.Update",
            "android": "com.victorycodedev.plugins.toastkit.ToastKitFunctions.Update",
            "ios": "ToastKitFunctions.Update",
            "description": "Updates an existing toast by ID."
        },
        {
            "name": "ToastKit.UpdateUnique",
            "android": "com.victorycodedev.plugins.toastkit.ToastKitFunctions.UpdateUnique",
            "ios": "ToastKitFunctions.UpdateUnique",
            "description": "Updates an existing toast by its unique key."
        },
        {
            "name": "ToastKit.Dismiss",
            "android": "com.victorycodedev.plugins.toastkit.ToastKitFunctions.Dismiss",
            "ios": "ToastKitFunctions.Dismiss",
            "description": "Dismisses an existing toast by ID."
        },
        {
            "name": "ToastKit.DismissUnique",
            "android": "com.victorycodedev.plugins.toastkit.ToastKitFunctions.DismissUnique",
            "ios": "ToastKitFunctions.DismissUnique",
            "description": "Dismisses an existing toast by its unique key."
        },
        {
            "name": "ToastKit.DismissAll",
            "android": "com.victorycodedev.plugins.toastkit.ToastKitFunctions.DismissAll",
            "ios": "ToastKitFunctions.DismissAll",
            "description": "Dismisses all active and queued toasts."
        }
    ],
    "android": {
        "min_version": 29,
        "init_function": "com.victorycodedev.plugins.toastkit.initializeToastKit"
    },
    "ios": {
        "min_version": "18.0",
        "init_function": "initializeToastKit"
    },
    "events": [
        "Victorycodedev\\ToastKit\\Events\\ToastShown",
        "Victorycodedev\\ToastKit\\Events\\ToastDismissed",
        "Victorycodedev\\ToastKit\\Events\\ToastActionPressed"
    ],
    "service_provider": "Victorycodedev\\ToastKit\\ToastKitServiceProvider"
}
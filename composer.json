{
    "name": "victorycodedev/toastkit",
    "description": "Rich, customizable native toast notifications for NativePHP Mobile.",
    "type": "nativephp-plugin",
    "license": "MIT",
    "keywords": [
        "nativephp",
        "nativephp-plugin",
        "mobile",
        "toast",
        "notifications"
    ],
    "homepage": "https://github.com/victorycodedev/toastkit",
    "support": {
        "issues": "https://github.com/victorycodedev/toastkit/issues",
        "source": "https://github.com/victorycodedev/toastkit"
    },
    "authors": [
        {
            "name": "Victory Efekpogua"
        }
    ],
    "require": {
        "php": "^8.4",
        "nativephp/mobile": "^4.1"
    },
    "autoload": {
        "psr-4": {
            "Victorycodedev\\ToastKit\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Victorycodedev\\ToastKit\\ToastKitServiceProvider"
            ]
        },
        "nativephp": {
            "manifest": "nativephp.json"
        }
    },
    "require-dev": {
        "pestphp/pest": "^4.0"
    },
    "scripts": {
        "test": "@php vendor/bin/pest --configuration phpunit.xml.dist"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}

{
    "name": "victorycodedev/toastkit",
    "description": "Rich, customizable native toast notifications for NativePHP Mobile.",
    "type": "nativephp-plugin",
    "license": "MIT",
    "authors": [
        {
            "name": "Victory Efekpogua"
        }
    ],
    "require": {
        "php": "^8.2",
        "nativephp/mobile": "^4.1"
    },
    "autoload": {
        "psr-4": {
            "Victorycodedev\\ToastKit\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Victorycodedev\\ToastKit\\ToastKitServiceProvider"
            ]
        },
        "nativephp": {
            "manifest": "nativephp.json"
        }
    },
    "require-dev": {
        "pestphp/pest": "^3.0"
    },
    "scripts": {
        "test": "pest"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}